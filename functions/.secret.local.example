# Copy to .secret.local for emulator tests only. Never commit real secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Each HMAC secret must be unique. Do not reuse inquiry or share secrets for proposals.
PORTAL_SHARE_HMAC_SECRET=
